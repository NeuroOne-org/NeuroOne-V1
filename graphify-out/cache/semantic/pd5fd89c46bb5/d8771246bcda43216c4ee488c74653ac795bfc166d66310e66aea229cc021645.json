{"nodes": [{"id": "docs_neuroone_mvp_scope", "label": "NEUROONE-MVP-SCOPE \u2014 Locked Scope Definition", "file_type": "document", "source_file": "docs/NEUROONE-MVP-SCOPE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_neuroone_mvp_scope_ai_phasing_decision", "label": "AI Phasing Decision (contract-real, provider-mocked)", "file_type": "rationale", "rationale": "The orchestrator interface and structured Diagnosis/Evidence contract are real and enforced now; only the retrieval corpus and LLM call are mocked behind that same interface. Fixing the contract first means AI-02 is a provider swap, not a pipeline rewrite.", "source_file": "docs/NEUROONE-MVP-SCOPE.md", "source_location": "AI phasing decision", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_neuroone_mvp_scope_early_detection_design", "label": "Early-Detection Design", "file_type": "rationale", "rationale": "Early detection for this MVP is trend-aware reasoning over clinician-entered data across a patient's visit history plus confidence-tiered output \u2014 not imaging or biomarkers. It implements FR-04's existing uncertainty requirement rather than adding a new functional requirement, so the PRD needs no rewrite.", "source_file": "docs/NEUROONE-MVP-SCOPE.md", "source_location": "Early-detection design", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_neuroone_mvp_scope_early_watch_category", "label": "early_watch Diagnosis Category", "file_type": "concept", "source_file": "docs/NEUROONE-MVP-SCOPE.md", "source_location": "Early-detection design", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_neuroone_mvp_scope_trend_basis", "label": "trend_basis (prior-visit traceability)", "file_type": "rationale", "rationale": "trend_basis traces to the patient's own visit history and is deliberately distinct from evidence[], which traces to external literature; conflating the two would break traceability guarantees.", "source_file": "docs/NEUROONE-MVP-SCOPE.md", "source_location": "Early-detection design", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_neuroone_mvp_scope_demo_data_assumption", "label": "Demo Data Assumption (synthetic, not real PHI)", "file_type": "rationale", "rationale": "Flagged as an assumption awaiting confirmation rather than decided silently: the system has not had a security review and should not hold real patient records yet.", "source_file": "docs/NEUROONE-MVP-SCOPE.md", "source_location": "Assumption flagged for confirmation", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_neuroone_mvp_scope_mocked_ai_credibility_risk", "label": "Mocked-AI Credibility Risk", "file_type": "rationale", "rationale": "A mocked AI backend returning schema-valid diagnoses will look real in a demo; it must stay labeled 'pipeline complete, evidence retrieval simulated' and never be narrated as clinically validated. This is an optics/credibility risk with investors, not just a code comment.", "source_file": "docs/NEUROONE-MVP-SCOPE.md", "source_location": "Risk to carry forward", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_neuroone_mvp_scope_roles", "label": "Confirmed Roles (ADMIN, CLINICIAN; RECEPTIONIST deferred)", "file_type": "concept", "source_file": "docs/NEUROONE-MVP-SCOPE.md", "source_location": "Roles", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_neuroone_mvp_scope_demo_ready_definition", "label": "Demo-Ready MVP Definition", "file_type": "concept", "source_file": "docs/NEUROONE-MVP-SCOPE.md", "source_location": "Definition of demo-ready MVP", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_neuroone_mvp_scope_sec_01", "label": "SEC-01 \u2014