{"nodes": [{"id": "docs_decisions_adr_002_visit_ownership_derivation", "label": "ADR-002 \u2014 Visit Ownership Derives From Parent Patient", "file_type": "document", "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_002_visit_ownership_derivation_single_ownership_rule", "label": "Single-Source Ownership Rule via Service Composition", "file_type": "rationale", "rationale": "VisitService composes PatientService and delegates every authorization decision, so the ownership rule lives in exactly one place and cannot drift. It also inherits soft-delete filtering for free. Denormalizing doctor_id onto Visit was rejected because it creates two sources of truth that must stay in sync on patient reassignment, and the problem recurs for every future child resource.", "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": "Decision 1 / Alternatives", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_002_visit_ownership_derivation_404_relabelling", "label": "404 Re-Labelling / Identifier Masking", "file_type": "rationale", "rationale": "A 404 is labelled with the resource the caller actually named. Letting a Patient-shaped EntityNotFoundError propagate on /visits/{id} would disclose the parent patient's UUID \u2014 an ADR-001 violation wearing a 404's clothing. Masking is about not disclosing identifiers the caller did not supply, so patient-scoped routes keep the honest Patient label.", "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": "Decision 2 / 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_002_visit_ownership_derivation_symptom_parent_check", "label": "Symptom-Belongs-To-Visit Verification", "file_type": "rationale", "rationale": "_load_authorized_symptom asserts symptom.visit_id == visit.id; without it, /visits/{A}/symptoms/{belongs-to-B} would silently edit a symptom on a different case. A mismatched pair reads as a missing symptom.", "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": "Decision 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_002_visit_ownership_derivation_soft_delete_no_cascade", "label": "Patient Soft-Delete Does Not Cascade to Visits", "file_type": "rationale", "rationale": "Not an access-control gap: because every visit read resolves ownership through get_patient, a soft-deleted patient's visits become immediately unreachable even though their rows keep is_deleted = False. Cleanup is a follow-up.", "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": "Consequences", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_decisions_adr_002_visit_ownership_derivation", "target": "docs_decisions_adr_001_ownership_violation_status_code", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": "Context", "weight": 1.0}, {"source": "docs_decisions_adr_002_visit_ownership_derivation", "target": "docs_neuroone_mvp_scope_case_01", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": "Context", "weight": 1.0}, {"source": "docs_decisions_adr_002_visit_ownership_derivation_404_relabelling", "target": "docs_decisions_adr_001_ownership_violation_status_code_enumeration_resistance", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": "Decision 2", "weight": 1.0}, {"source": "docs_decisions_adr_002_visit_ownership_derivation_single_ownership_rule", "target": "docs_trd_service_layer", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": "Decision 1", "weight": 1.0}, {"source": "docs_decisions_adr_002_visit_ownership_derivation_single_ownership_rule", "target": "agents_overridable_service_providers", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": "Decision 1 \u2014 AuthService(user_service) pattern in app/api/dependencies.py", "weight": 1.0}, {"source": "docs_decisions_adr_002_visit_ownership_derivation_soft_delete_no_cascade", "target": "docs_trd_database_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": "Consequences", "weight": 1.0}, {"source": "docs_decisions_adr_002_visit_ownership_derivation_symptom_parent_check", "target": "docs_decisions_adr_002_visit_ownership_derivation_404_relabelling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": "Decision 4", "weight": 1.0}, {"source": "docs_decisions_adr_002_visit_ownership_derivation", "target": "docs_neuroone_mvp_scope_ai_01", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md", "source_location": "Consequences \u2014 AI-01 calls VisitService.get_patient_history() in-process", "weight": 1.0}], "hyperedges": [{"id": "ownership_enforcement_pattern", "label": "Per-Record Ownership Enforcement Pattern (404 masking, derived one hop up)", "nodes": ["docs_decisions_adr_001_ownership_violation_status_code_enumeration_resistance", "docs_decisions_adr_001_ownership_violation_status_code_role_vs_record_gating", "docs_decisions_adr_002_visit_ownership_derivation_single_ownership_rule", "docs_decisions_adr_002_visit_ownership_derivation_404_relabelling", "docs_decisions_adr_002_visit_ownership_derivation_symptom_parent_check", "docs_trd_error_handling"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-002-visit-ownership-derivation.md"}]}