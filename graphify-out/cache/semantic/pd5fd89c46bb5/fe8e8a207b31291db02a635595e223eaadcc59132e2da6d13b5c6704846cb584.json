{"nodes": [{"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_two_narrow_protocol_seam", "label": "Two Narrow Protocol Provider Seam", "file_type": "rationale", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrieval and reasoning fail differently and are swapped independently, so AI-02 may land a real corpus before a real LLM or vice versa. Splitting them also lets tests inject a failing retriever alongside a healthy LLM to exercise the data-preservation rule precisely. A single combined AIProvider was rejected as coupling two independently swappable concerns."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_evidenceretriever", "label": "EvidenceRetriever Protocol", "file_type": "code", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 1, backend/app/ai/providers/base.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_llmclient", "label": "LLMClient Protocol", "file_type": "code", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 1, backend/app/ai/providers/base.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_registry_build_providers", "label": "registry.build_providers()", "file_type": "code", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single selection point for provider construction, driven by the AI_PROVIDER config setting, so mock branching never leaks into the orchestrator."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_diagnosiscandidate", "label": "DiagnosisCandidate", "file_type": "code", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 1, Consequences", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sets extra=\"forbid\" because a real LLM inventing a field is a contract failure, not a field to ignore. evidence is min_length=1 because a ranked condition with no citation is exactly the untraceable output the traceability rule forbids."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_reasoningresult", "label": "ReasoningResult", "file_type": "code", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_retrieveddocument", "label": "RetrievedDocument", "file_type": "code", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Addendum", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carries document_id, chunk_id, source_tier, published_year and relevance_score; typing DiagnosisCandidate.evidence as this full record rather than the narrowed EvidenceRef stops source metadata being silently discarded."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_evidenceref", "label": "EvidenceRef (narrowed wire shape)", "file_type": "code", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Addendum", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_clinicalcontext", "label": "ClinicalContext", "file_type": "code", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_database_free_ai_package", "label": "Database-Free app/ai Package", "file_type": "rationale", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app/ai/ never imports a repository and never touches a Session; it accepts a ClinicalContext and returns an AnalysisResult. The single exception is context.py reading attributes off already-loaded ORM instances, which is the Normalize Input stage. Everything downstream is therefore unit-testable without a database."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_rule_based_determinism", "label": "Rule-Based Deterministic Mock Scoring", "file_type": "rationale", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No RNG and no canned results: the score is arithmetic over what the clinician actually entered, ordered by (-confidence, name) so ties are total and reproducible. Seeded RNG is stable but arbitrary and cannot make an early_watch point at a real trend; golden fixtures do not respond to input, so ranking and validation would never execute and the demo would answer identically regardless of input."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_max_confidence", "label": "MAX_CONFIDENCE Ceiling of 0.92", "file_type": "concept", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confidence is clamped so output never expresses certainty; likelihood, never certainty."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_early_watch_category", "label": "early_watch Category Derived From Trend Evidence", "file_type": "rationale", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A candidate is early_watch when one of its matched symptoms participates in a worsening multi-visit trend and its confidence is below the differential threshold. Because such a candidate takes its trend_basis from those very trend points, the invariant early_watch implies non-empty trend_basis holds by construction; the schema validator is a second line of defence, not the only one."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_analysis_tables", "label": "analyses / analysis_findings / analysis_evidence Tables", "file_type": "concept", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The legacy Diagnosis and Rag stubs are deleted rather than extended. The persisted column is condition_name on analysis_findings; the names final_diagnosis, doctor_verified, probability, certainty and a bare diagnosis are excluded by decision, not oversight."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_evidence_scoped_to_finding", "label": "Evidence Scoped to a Finding, Not a Report", "file_type": "rationale", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 5, Why", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Citations attach to recommendations, so a report-scoped bag of sources cannot say which condition a citation supports and the mandated chain patient finding + reasoning factor + supporting evidence + citation would be unrepresentable. REPORT-01 reaches evidence via report to analysis to finding to evidence and needs no table of its own."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_trend_basis_json_column", "label": "trend_basis as a JSON Column", "file_type": "rationale", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 6, Why, Consequences", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It is a snapshot of reasoning, not a live relation: foreign keys would let a later severity edit silently rewrite what a past analysis said, defeating traceability. It is never queried or filtered, only read whole. The UUIDs inside are real visits.id / symptoms.id values but are soft references by design, so a dangling id honestly means the underlying record changed since the analysis ran, which is information rather than corruption."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_failure_precedes_first_write", "label": "Failure Precedes the First Write", "file_type": "rationale", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 7, Why", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every read and every provider call happens before the first write, so when a failure occurs there is nothing to roll back and no recovery path to get wrong. Ordering is a stronger guarantee than exception handling: a try/except around a partially-completed write would satisfy the letter of the rule while leaving a window the ordering approach does not have."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_analysisrepository_create_with_status", "label": "AnalysisRepository.create_with_status", "file_type": "code", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 7, Consequences", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One commit writes analysis + findings + evidence + visit.status=ANALYZED, and is the single place VisitStatus.ANALYZED is written."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_resolve_evidence", "label": "_resolve_evidence Orchestrator Stage", "file_type": "code", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Addendum", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A provider is only trusted to select evidence by id, never to be the source of truth for that evidence's content. Re-resolving each document_id against the orchestrator's own retrieval output means a real LLM cannot alter or fabricate citation metadata even if it echoes a document back with different values; only document_id is load-bearing. An unresolvable id raises AIError(ai_contract_error)."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_pipeline_note", "label": "pipeline_note Provenance Label", "file_type": "concept", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Risks", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mock-sourced output must stay labelled 'pipeline complete, evidence retrieval simulated' because a mocked pipeline returning schema-valid output looks real in a demo; the mitigation is ultimately narrative, not technical."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_provider_mode", "label": "provider_mode", "file_type": "concept", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Risks", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_reanalysis_creates_new_row", "label": "Re-Running Analysis Creates a New Row", "file_type": "rationale", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Consequences", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no unique constraint on visit_id: re-analysing after adding symptoms is the natural clinician action, and overwriting would destroy prior traceable output. get_latest_for_visit orders by created_at DESC."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_no_failed_rows", "label": "A Failed Run Persists Nothing", "file_type": "rationale", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Consequences, Alternatives Rejected", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persisting FAILED analysis rows would add an enum and a migration hazard to represent something logging already covers, and risks a failed run being read as clinical output. Failure telemetry is logging with visit id only, never patient data."}, {"id": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_aierror", "label": "AIError Controlled Failure", "file_type": "code", "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 1, Addendum", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_two_narrow_protocol_seam", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_evidenceretriever", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 1", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_two_narrow_protocol_seam", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_llmclient", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 1", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_registry_build_providers", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_evidenceretriever", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 1", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_registry_build_providers", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_llmclient", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 1", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_reasoningresult", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_diagnosiscandidate", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 1 \u2014 'ReasoningResult.candidates is list[DiagnosisCandidate]'", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_diagnosiscandidate", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_retrieveddocument", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Addendum \u2014 'DiagnosisCandidate.evidence is now typed list[RetrievedDocument]'", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_retrieveddocument", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_evidenceref", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Addendum", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_resolve_evidence", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_retrieveddocument", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Addendum", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_resolve_evidence", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_aierror", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Addendum \u2014 'raises AIError(error_code=\"ai_contract_error\")'", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_database_free_ai_package", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_clinicalcontext", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 2", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_rule_based_determinism", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_max_confidence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 3", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_early_watch_category", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_trend_basis_json_column", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 4", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_early_watch_category", "target": "docs_trd_trend_basis", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Context, Decision 4", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_analysis_tables", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_evidence_scoped_to_finding", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 5", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_analysisrepository_create_with_status", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_failure_precedes_first_write", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 7", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_analysisrepository_create_with_status", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_analysis_tables", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Decision 7", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_two_narrow_protocol_seam", "target": "docs_trd_ai_pipeline", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Constraints \u2014 'The pipeline stages are fixed by TRD \u00a78'", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_two_narrow_protocol_seam", "target": "docs_decisions_adr_001_ownership_violation_status_code_ownership_violations_return_404", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Constraints \u2014 'a foreign record must 404 without disclosing the parent'", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_pipeline_note", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_provider_mode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Risks", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_diagnosiscandidate", "target": "docs_trd_ai_output_contract", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Context, Constraints", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_no_failed_rows", "target": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_failure_precedes_first_write", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Consequences", "weight": 1.0}, {"source": "docs_decisions_adr_003_ai_analysis_contract_and_provider_seam_evidence_scoped_to_finding", "target": "docs_trd_rag_rules", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-003-ai-analysis-contract-and-provider-seam.md", "source_location": "Why \u2014 'attach citations to recommendations'", "weight": 1.0}], "hyperedges": []}