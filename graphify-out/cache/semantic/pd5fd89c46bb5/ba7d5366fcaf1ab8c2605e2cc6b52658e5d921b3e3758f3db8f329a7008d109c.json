{"nodes": [{"id": "docs_decisions_adr_001_ownership_violation_status_code_ownership_violations_return_404", "label": "Ownership Violations Return 404, Not 403", "file_type": "rationale", "source_file": "docs/decisions/ADR-001-ownership-violation-status-code.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Patients are PHI-adjacent, so a 403 confirming record existence to an unauthorized caller is an information-disclosure and enumeration surface not worth the marginal honesty benefit to someone who mistyped an ID. A uniform 404 across true-absence and ownership-violation means client code never special-cases which kind of 404 it received."}, {"id": "docs_decisions_adr_001_ownership_violation_status_code_per_record_ownership_check", "label": "Per-Record Ownership Check", "file_type": "concept", "source_file": "docs/decisions/ADR-001-ownership-violation-status-code.md", "source_location": "Context, Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A CLINICIAN may only access patients where patient.doctor_id == current_user.id; an ADMIN is unrestricted. Scoped narrowly to per-record checks, deliberately distinct from role-level exclusion."}, {"id": "docs_decisions_adr_001_ownership_violation_status_code_require_roles", "label": "require_roles Role-Level 403 Signaling", "file_type": "concept", "source_file": "docs/decisions/ADR-001-ownership-violation-status-code.md", "source_location": "Constraints, Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Role-level exclusions continue to use 403 because there is no record-existence information to protect: the caller already knows the endpoint exists."}, {"id": "docs_decisions_adr_001_ownership_violation_status_code_patientservice_authorize_access", "label": "PatientService._authorize_access", "file_type": "code", "source_file": "docs/decisions/ADR-001-ownership-violation-status-code.md", "source_location": "Consequences", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raises the same EntityNotFoundError for 'doesn't exist' and 'exists but not yours' so API call sites need not distinguish them."}, {"id": "docs_decisions_adr_001_ownership_violation_status_code_entitynotfounderror", "label": "EntityNotFoundError", "file_type": "code", "source_file": "docs/decisions/ADR-001-ownership-violation-status-code.md", "source_location": "Consequences", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_001_ownership_violation_status_code_enumeration_resistance", "label": "Enumeration Resistance for PHI-Adjacent Resources", "file_type": "rationale", "source_file": "docs/decisions/ADR-001-ownership-violation-status-code.md", "source_location": "Constraints, Problem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Which response the API gives is itself a small information disclosure; enumeration resistance matters more for a UUID-keyed resource tied to a real patient than for a low-sensitivity resource."}, {"id": "docs_decisions_adr_001_ownership_violation_status_code_server_side_audit_logging", "label": "Server-Side Audit Logging of the Real Reason", "file_type": "concept", "source_file": "docs/decisions/ADR-001-ownership-violation-status-code.md", "source_location": "Consequences", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 404 is a caller-facing signal only, not a logging decision: logs must still capture ownership violation vs true absence for audit and debugging."}], "edges": [{"source": "docs_decisions_adr_001_ownership_violation_status_code_ownership_violations_return_404", "target": "docs_decisions_adr_001_ownership_violation_status_code_per_record_ownership_check", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-001-ownership-violation-status-code.md", "source_location": "Decision", "weight": 1.0}, {"source": "docs_decisions_adr_001_ownership_violation_status_code_enumeration_resistance", "target": "docs_decisions_adr_001_ownership_violation_status_code_ownership_violations_return_404", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-001-ownership-violation-status-code.md", "source_location": "Problem, Constraints", "weight": 1.0}, {"source": "docs_decisions_adr_001_ownership_violation_status_code_patientservice_authorize_access", "target": "docs_decisions_adr_001_ownership_violation_status_code_entitynotfounderror", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-001-ownership-violation-status-code.md", "source_location": "Consequences", "weight": 1.0}, {"source": "docs_decisions_adr_001_ownership_violation_status_code_patientservice_authorize_access", "target": "docs_decisions_adr_001_ownership_violation_status_code_per_record_ownership_check", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-001-ownership-violation-status-code.md", "source_location": "Consequences", "weight": 1.0}, {"source": "docs_decisions_adr_001_ownership_violation_status_code_entitynotfounderror", "target": "docs_trd_centralized_error_translation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-001-ownership-violation-status-code.md", "source_location": "Consequences \u2014 'via the centralized error handler (TRD \u00a711)'", "weight": 1.0}, {"source": "docs_decisions_adr_001_ownership_violation_status_code_per_record_ownership_check", "target": "docs_trd_role_based_authorization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/dec