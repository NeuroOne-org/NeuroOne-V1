{"nodes": [{"id": "docs_trd_layered_architecture", "label": "Layered Architecture (API to Service to Repository to PostgreSQL)", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a71, \u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "API does HTTP routing/validation/serialization with no business logic; Services own business rules, authorization decisions and repository/AI coordination; Repositories do persistence only with no HTTP logic. Separation keeps domain exceptions independent of HTTP concerns."}, {"id": "docs_trd_technology_stack", "label": "Technology Stack (FastAPI, Pydantic 2, SQLAlchemy, Alembic, PostgreSQL)", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_backend_layout", "label": "Backend Directory Layout", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_initial_domain_entities", "label": "Initial Domain Entities (User, Patient, Clinical Case/Visit, Diagnosis, Evidence, Report)", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a74 Models", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_jwt_authentication", "label": "JWT Authentication Flow", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authentication dependencies expose overridable service providers rather than constructing services directly inside request dependencies, so tests and alternate wiring can substitute them."}, {"id": "docs_trd_role_based_authorization", "label": "Role-Based Authorization (ADMIN, CLINICIAN)", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Access control is enforced server-side at API/service boundaries rather than trusted to the client."}, {"id": "docs_trd_ai_pipeline", "label": "AI Pipeline Stages", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Case Data to Normalize to Build Clinical Context to Retrieve Evidence to Rank Evidence to Build AI Context to LLM to Structured Output to Validate to Persist/Return. AI output must use a structured contract rather than unvalidated free-form text."}, {"id": "docs_trd_ai_output_contract", "label": "AI Output Contract (Diagnosis structure)", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fields: name, category (differential_diagnosis | early_watch), likelihood/confidence, supporting_findings, contradicting_findings, explanation, trend_basis[], evidence[]. Structured rather than free text so validation and traceability are enforceable."}, {"id": "docs_trd_trend_basis", "label": "trend_basis (patient's own visit history)", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "trend_basis traces to the patient's own visit history while evidence[] traces to external literature; the two are distinct and must not be conflated, because conflating internal history with external citation would make the traceability chain meaningless."}, {"id": "docs_trd_evidence_array", "label": "evidence[] (external literature citations)", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_rag_rules", "label": "RAG Rules", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accept clinical context, retrieve literature, rank/select evidence, preserve source metadata, supply evidence to the model, attach citations to recommendations. Trusted medical sources are prioritized."}, {"id": "docs_trd_centralized_error_translation", "label": "Centralized Domain-to-HTTP Error Translation", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Domain exceptions stay independent of HTTP concerns; one central handler maps validation, auth, not-found, conflict, database, AI and external-service errors to HTTP responses."}, {"id": "docs_trd_testing_categories", "label": "Testing Categories (Unit, Integration, AI)", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_implementation_sequence", "label": "Implementation Sequence", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_trd_ai_output_contract", "target": "docs_trd_trend_basis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/TRD.md", "source_location": "\u00a79", "weight": 1.0}, {"source": "docs_trd_ai_output_contract", "target": "docs_trd_evidence_array", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/TRD.md", "source_location": "\u00a79", "weight": 1.0}, {"source": "docs_trd_ai_pipeline", "target": "docs_trd_ai_output_contract", "relation": "conceptually_rel