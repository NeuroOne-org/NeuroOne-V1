#example of the .env file keep that shyt in backend root

APP_NAME=NeuroONE
APP_VERSION=0.1.0

#"development" or "production". Only gates AUTH_REQUIRE_OTP below -- the
#backend refuses to start as production with OTP off.
APP_ENV=development

DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/NeuroOne
JWT_SECRET_KEY=char_botal_vodka
JWT_ALGORITHM=HS256

#30 minutes is the production-appropriate value. In development, a longer
#value (e.g. 720 = 12h) means you sign in about once a day instead of every
#half hour.
ACCESS_TOKEN_EXPIRE_MINUTES=30

#false: /auth/login issues a token from the password alone -- convenient
#for local development, never for a real deployment. true: /auth/login
#sends an OTP and withholds the token until it's verified at
#/auth/verify-otp. Must be true when APP_ENV=production -- the backend
#refuses to start otherwise.
AUTH_REQUIRE_OTP=true

#"email" sends the OTP via Gmail SMTP (needs GMAIL_ADDRESS/GMAIL_APP_PASSWORD
#below). "console" logs the code to the backend terminal instead -- useful
#in development so you don't wait on Gmail or hit its sending limits while
#testing the 2FA flow. Never use "console" in production.
OTP_DELIVERY=email

#the browser session token is an HttpOnly cookie. true marks it Secure, so it
#never travels over plain HTTP. Chrome, Edge and Firefox treat
#http://localhost as secure, so true works locally; set false only if your
#browser drops the cookie on localhost. Must be true when APP_ENV=production.
SESSION_COOKIE_SECURE=true

#comma-separated is NOT supported by pydantic-settings here — use a JSON array
#use the same hostname as the frontend (localhost vs 127.0.0.1): the session
#cookie is SameSite=Strict and is not sent between different sites.
CORS_ORIGINS=["http://localhost:3000"]

#Google Account → Security → App Passwords
#you'll need 2FA
#generate a password and put it down here
#only required when OTP_DELIVERY=email

GMAIL_ADDRESS=youremail@gmail.com
GMAIL_APP_PASSWORD=somerandom16letters

#AI providers (ADR-005)
#"mock" is deterministic, offline and the default. "live-llm" is real model
#reasoning over a still-simulated corpus, and it sends the patient's clinical
#context to a third party — only ever point it at synthetic demo data.

AI_PROVIDER=mock

#any OpenAI-compatible /chat/completions endpoint, so the provider is a config
#change, not a code change. free options that work here:
#  Groq        https://api.groq.com/openai/v1          openai/gpt-oss-120b
#  Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#  OpenRouter  https://openrouter.ai/api/v1            (models suffixed :free)
#  Ollama      http://localhost:11434/v1               (local, no key needed)
#required when AI_PROVIDER=live-llm. never commit a real key.

AI_LLM_BASE_URL=https://api.groq.com/openai/v1
#a hosted model id can be retired without notice — check the provider's
#/models endpoint if you get a 404 with code "model_not_found".
AI_LLM_MODEL=openai/gpt-oss-120b
AI_LLM_API_KEY=put_your_own_key_here
AI_LLM_TIMEOUT_SECONDS=30
AI_LLM_MAX_OUTPUT_TOKENS=2048
