#example of the .env file keep that shyt in backend root

APP_NAME=NeuroONE
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/NeuroOne
JWT_SECRET_KEY=char_botal_vodka
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

#Google Account → Security → App Passwords
#you'll need 2FA
#generate a password and put it down here

GMAIL_ADDRESS=youremail@gmail.com
GMAIL_APP_PASSWORD=somerandom16letters

#AI providers (ADR-004)
#"mock" is deterministic, offline and the default. "live-llm" is real model
#reasoning over a still-simulated corpus, and it sends the patient's clinical
#context to a third party — only ever point it at synthetic demo data.

AI_PROVIDER=mock

#any OpenAI-compatible /chat/completions endpoint, so the provider is a config
#change, not a code change. free options that work here:
#  Groq        https://api.groq.com/openai/v1          llama-3.3-70b-versatile
#  Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#  OpenRouter  https://openrouter.ai/api/v1            (models suffixed :free)
#  Ollama      http://localhost:11434/v1               (local, no key needed)
#required when AI_PROVIDER=live-llm. never commit a real key.

AI_LLM_BASE_URL=https://api.groq.com/openai/v1
AI_LLM_MODEL=llama-3.3-70b-versatile
AI_LLM_API_KEY=put_your_own_key_here
AI_LLM_TIMEOUT_SECONDS=30
AI_LLM_MAX_OUTPUT_TOKENS=2048